{
  "vae": {
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Flux2 VAE"
    }
  },
  "model": {
    "inputs": {
      "unet_name": "flux-2-klein-9b.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Flux2 Klein 9B"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_3_8b_fp8mixed.safetensors",
      "type": "flux2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Flux2 text encoder"
    }
  },
  "reference_image": {
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "ENGINE_REFERENCE_IMAGE"
    }
  },
  "reference_scale": {
    "inputs": {
      "image": [
        "reference_image",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 1
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Canonical reference scale"
    }
  },
  "reference_size": {
    "inputs": {
      "image": [
        "reference_scale",
        0
      ]
    },
    "class_type": "GetImageSize",
    "_meta": {
      "title": "Reference dimensions"
    }
  },
  "reference_latent": {
    "inputs": {
      "pixels": [
        "reference_scale",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Encode canonical reference"
    }
  },
  "positive": {
    "inputs": {
      "text": "Preserve the identity, location and visual continuity of the reference image.",
      "clip": [
        "clip",
        0
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "ENGINE_PROMPT"
    }
  },
  "positive_reference": {
    "inputs": {
      "conditioning": [
        "positive",
        0
      ],
      "latent": [
        "reference_latent",
        0
      ]
    },
    "class_type": "ReferenceLatent",
    "_meta": {
      "title": "Canonical reference conditioning"
    }
  },
  "negative": {
    "inputs": {
      "conditioning": [
        "positive",
        0
      ]
    },
    "class_type": "ConditioningZeroOut",
    "_meta": {
      "title": "Zero negative conditioning"
    }
  },
  "empty_latent": {
    "inputs": {
      "width": [
        "reference_size",
        0
      ],
      "height": [
        "reference_size",
        1
      ],
      "batch_size": 1
    },
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {
      "title": "Output latent"
    }
  },
  "consistency_lora": {
    "inputs": {
      "model": [
        "model",
        0
      ],
      "lora_name": "Klein-consistency.safetensors",
      "strength_model": 0.8
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Klein consistency"
    }
  },
  "sampler": {
    "inputs": {
      "model": [
        "consistency_lora",
        0
      ],
      "seed": 1,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "positive_reference",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "latent_image": [
        "empty_latent",
        0
      ],
      "denoise": 1.0
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Flux2 Klein consistency sampler"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    }
  },
  "save": {
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "content_pipeline/reference"
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "ENGINE_OUTPUT"
    }
  }
}
