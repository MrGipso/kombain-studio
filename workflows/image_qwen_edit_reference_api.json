{
  "vae": {
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Qwen image VAE"
    }
  },
  "model": {
    "inputs": {
      "unet_name": "qwen_image_edit_2511_bf16.safetensors",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Qwen Image Edit 2511"
    }
  },
  "clip": {
    "inputs": {
      "clip_name": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Qwen vision-language encoder"
    }
  },
  "reference_image": {
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "ENGINE_REFERENCE_IMAGE"
    }
  },
  "reference_scale": {
    "inputs": {
      "image": [
        "reference_image",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 2.0,
      "resolution_steps": 1
    },
    "class_type": "ImageScaleToTotalPixels",
    "_meta": {
      "title": "Reference scale"
    }
  },
  "positive": {
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "image1": [
        "reference_scale",
        0
      ],
      "prompt": "Preserve the subject and visual continuity while following the requested new composition."
    },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "ENGINE_PROMPT"
    }
  },
  "negative": {
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "image1": [
        "reference_scale",
        0
      ],
      "prompt": ""
    },
    "class_type": "TextEncodeQwenImageEditPlus",
    "_meta": {
      "title": "Qwen negative"
    }
  },
  "positive_reference_method": {
    "inputs": {
      "conditioning": [
        "positive",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    },
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": {
      "title": "Positive reference method"
    }
  },
  "negative_reference_method": {
    "inputs": {
      "conditioning": [
        "negative",
        0
      ],
      "reference_latents_method": "index_timestep_zero"
    },
    "class_type": "FluxKontextMultiReferenceLatentMethod",
    "_meta": {
      "title": "Negative reference method"
    }
  },
  "input_latent": {
    "inputs": {
      "pixels": [
        "reference_scale",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEEncode",
    "_meta": {
      "title": "Reference latent"
    }
  },
  "lightning_lora": {
    "inputs": {
      "model": [
        "model",
        0
      ],
      "lora_name": "Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors",
      "strength_model": 1.0
    },
    "class_type": "LoraLoaderModelOnly",
    "_meta": {
      "title": "Qwen Edit Lightning"
    }
  },
  "sampling": {
    "inputs": {
      "model": [
        "lightning_lora",
        0
      ],
      "shift": 3.1
    },
    "class_type": "ModelSamplingAuraFlow",
    "_meta": {
      "title": "Qwen sampling"
    }
  },
  "cfg_norm": {
    "inputs": {
      "model": [
        "sampling",
        0
      ],
      "strength": 1.0
    },
    "class_type": "CFGNorm",
    "_meta": {
      "title": "CFG norm"
    }
  },
  "sampler": {
    "inputs": {
      "model": [
        "cfg_norm",
        0
      ],
      "seed": 1,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "positive_reference_method",
        0
      ],
      "negative": [
        "negative_reference_method",
        0
      ],
      "latent_image": [
        "input_latent",
        0
      ],
      "denoise": 1.0
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "Qwen edit sampler"
    }
  },
  "decode": {
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decode"
    }
  },
  "save": {
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "content_pipeline/reference_qwen"
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "ENGINE_OUTPUT"
    }
  }
}
